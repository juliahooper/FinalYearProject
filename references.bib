  pages = {1--8},
  doi = {10.1109/ARIIA63345.2024.11051905},
  url = {https://ieeexplore.ieee.org/document/11051905},
  urldate = {2026-10-31},
  abstract = {Across sectors, from finance to healthcare, Artificial Intelligence (AI) algorithms are used for more and more of the decisions that shape our lives as individuals and collectively. But as the use of AI systems has exploded, there have been major questions about biases within these algorithms that can allow unfair and unethical results. In this paper, we explore these methods in identifying and remediating bias AI algorithms to achieve fairness and ethical integrity. First, we follow an investigation on the origins and nature of biases within AI: how crowdsourced biased training data pollutes developing models; injustice model assumptions account for these troubles unfortunately there are some scenarios that cannot justify collective decision-making. The study later discusses through some methods for identifying biases based on statistical analysis, bias auditing as well fairness through use of metrics. We learn a wide range of these biases (racial, gender and socioeconomic), as well how they appear in AI outputs. In order to tackle these problems, we survey several mitigation techniques including re- sampling strategies, algorithmic modifications and fairness constraints during training. We also broach transparency of accountability, and ethical standards in AI creation or deployment. It discusses the necessity of integrating ethicists, sociologists and AI researchers to enable robust bias mitigation frameworks. Using extensive-case studies and experimental evaluation, we show the efficacy of our proposed approaches in mitigating biases and improving AI fairness. This highlights the need for ongoing monitoring and iterative improvements to preserve ethical practices when using AI. In the end, this research is expected to help create fairer AI technologies that are trustworthy and serve all segments of society without reproducing or exacerbating existing inequities.},
  eventtitle = {2024 {{International Conference}} on {{Augmented Reality}}, {{Intelligent Systems}}, and {{Industrial Automation}} ({{ARIIA}})},
  keywords = {Algorithmic Bias,Artificial intelligence,Bias Detection Techniques,Bias Mitigation,Data models,Ethical AI,Ethics,Fairness in AI,Interdisciplinary Collaboration in AI,Monitoring,Prevention and mitigation,Standards,Statistical analysis,Surveys,Training,Training data}
}

