@article{caliskan2017semantics,
  title = {Semantics Derived Automatically from Language Corpora Contain Human-like Biases},
  author = {Caliskan, Aylin and Bryson, Joanna J. and Narayanan, Arvind},
  date = {2017-04-14},
  journaltitle = {Science},
  volume = {356},
  number = {6334},
  pages = {183--186},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.aal4230},
  url = {https://www.science.org/doi/abs/10.1126/science.aal4230},
  urldate = {2026-10-31},
  abstract = {Machine learning is a means to derive artificial intelligence by discovering patterns in existing data. Here, we show that applying machine learning to ordinary human language results in human-like semantic biases. We replicated a spectrum of known biases, as measured by the Implicit Association Test, using a widely used, purely statistical machine-learning model trained on a standard corpus of text from the World Wide Web. Our results indicate that text corpora contain recoverable and accurate imprints of our historic biases, whether morally neutral as toward insects or flowers, problematic as toward race or gender, or even simply veridical, reflecting the status quo distribution of gender with respect to careers or first names. Our methods hold promise for identifying and addressing sources of bias in culture, including technology.},
  file = {C:\Users\user\Zotero\storage\CJTK6SE7\Caliskan et al. - 2017 - Semantics derived automatically from language corpora contain human-like biases.pdf}
}

@inproceedings{kumar2025detecting,
  title = {Detecting and {{Mitigating Bias}} in {{LLMs}} through {{Knowledge Graph-Augmented Training}}},
  booktitle = {2025 {{International Conference}} on {{Artificial Intelligence}} and {{Data Engineering}} ({{AIDE}})},
  author = {Kumar, Rajeev and Kumar, Harishankar and Shalini, Kumari},
  date = {2025-02},
  pages = {608--613},
  doi = {10.1109/AIDE64228.2025.10987418},
  url = {https://ieeexplore.ieee.org/document/10987418},
  urldate = {2026-10-31},
  abstract = {Large language models have revolutionized natural language processing with their surprising capability to understand and generate human-like text. However, many of these models inherit and further amplify the biases present in their training data, raising ethical and fairness concerns. The detection and mitigation of such biases are vital to ensuring that LLMs act responsibly and equitably across diverse domains. This work investigates Knowledge Graph-Augmented Training (KGAT) as a novel method to mitigate bias in LLM. Using structured domain-specific knowledge from real-world knowledge graphs, we improve the understanding of the model and reduce biased output. Public datasets for bias assessment include Gender Shades, Bias in Bios, and FairFace, while metrics such as demographic parity and equal opportunity facilitate rigorous detection. We also performed targeted mitigation strategies to correct biased associations, leading to a significant drop in biased output and improved bias metrics. Equipped with real-world datasets and knowledge graphs, our framework is both scalable and effective, paving the way toward responsible deployment in sensitive and high-stakes applications.},
  eventtitle = {2025 {{International Conference}} on {{Artificial Intelligence}} and {{Data Engineering}} ({{AIDE}})},
  keywords = {Bias Detection,Bias Mitigation,Biological system modeling,Data models,Equal opportunities,Ethics,Knowledge Graph-Augmented Training,Knowledge graphs,Large language models,Large Language Models,Measurement,Prevention and mitigation,Real-World Datasets,Training,Training data},
  file = {C:\Users\user\Zotero\storage\5MYNLNBA\Kumar et al. - 2025 - Detecting and Mitigating Bias in LLMs through Knowledge Graph-Augmented Training.pdf}
}

@inproceedings{rajawatInvestigatingMethodsIdentify2024,
  title = {Investigating Methods to Identify and Mitigate Biases in {{AI}} Algorithms to Ensure Fair and Ethical Outcomes},
  booktitle = {2024 {{International Conference}} on {{Augmented Reality}}, {{Intelligent Systems}}, and {{Industrial Automation}} ({{ARIIA}})},
  author = {Rajawat, Anand Singh and Goyal, S. B. and Abdul-Wadood, Dalia N.},
  date = {2024-12},
  pages = {1--8},
  doi = {10.1109/ARIIA63345.2024.11051905},
  url = {https://ieeexplore.ieee.org/document/11051905},
  urldate = {2026-10-31},
  abstract = {Across sectors, from finance to healthcare, Artificial Intelligence (AI) algorithms are used for more and more of the decisions that shape our lives as individuals and collectively. But as the use of AI systems has exploded, there have been major questions about biases within these algorithms that can allow unfair and unethical results. In this paper, we explore these methods in identifying and remediating bias AI algorithms to achieve fairness and ethical integrity. First, we follow an investigation on the origins and nature of biases within AI: how crowdsourced biased training data pollutes developing models; injustice model assumptions account for these troubles unfortunately there are some scenarios that cannot justify collective decision-making. The study later discusses through some methods for identifying biases based on statistical analysis, bias auditing as well fairness through use of metrics. We learn a wide range of these biases (racial, gender and socioeconomic), as well how they appear in AI outputs. In order to tackle these problems, we survey several mitigation techniques including re- sampling strategies, algorithmic modifications and fairness constraints during training. We also broach transparency of accountability, and ethical standards in AI creation or deployment. It discusses the necessity of integrating ethicists, sociologists and AI researchers to enable robust bias mitigation frameworks. Using extensive-case studies and experimental evaluation, we show the efficacy of our proposed approaches in mitigating biases and improving AI fairness. This highlights the need for ongoing monitoring and iterative improvements to preserve ethical practices when using AI. In the end, this research is expected to help create fairer AI technologies that are trustworthy and serve all segments of society without reproducing or exacerbating existing inequities.},
  eventtitle = {2024 {{International Conference}} on {{Augmented Reality}}, {{Intelligent Systems}}, and {{Industrial Automation}} ({{ARIIA}})},
  keywords = {Algorithmic Bias,Artificial intelligence,Bias Detection Techniques,Bias Mitigation,Data models,Ethical AI,Ethics,Fairness in AI,Interdisciplinary Collaboration in AI,Monitoring,Prevention and mitigation,Standards,Statistical analysis,Surveys,Training,Training data}
}
